# Salin ke .env lalu isi. JANGAN commit .env.
DJANGO_DEBUG=0
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=namadomain-anda.example
CSRF_TRUSTED_ORIGINS=https://namadomain-anda.example
# Kosongkan jika frontend & API satu domain; isi jika beda domain (mis. https://pos.pages.dev)
CORS_ALLOWED_ORIGINS=

# Verifikasi email manajer (atau set REQUIRE_EMAIL_VERIFICATION=0)
FRONTEND_BASE_URL=https://namadomain-anda.example
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=NEXT POS <alamat-gmail-anda@gmail.com>

DB_ENGINE=mysql
DB_NAME=next_pos
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# MySQL terkelola yang mewajibkan TLS (mis. TiDB Cloud, port 4000): set 1
DB_SSL=0
# DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt
